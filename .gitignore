# Environment files
.env
.env.local
*.env
!.env.example

# Backend (Python)
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/*.db
backend/*.db-journal
*.pyc

# ATS training data (resumes you paste in, generated CSV, cached LLM labels) —
# local only, never committed. Seed job descriptions live in backend/scripts/
# instead (version-controlled, hand-authored, no PII).
backend/data/*
!backend/data/.gitkeep

# Trained ATS model binary — regenerate locally via scripts/train_ats_model.py.
# Metadata (accuracy, dataset size, training date) stays tracked — it's the
# small, useful record of what's currently deployed.
backend/app/ml/models/*.joblib

# Frontend (Node/Next.js) — frontend/ has its own .gitignore for its internals,
# this covers the case of running commands from the repo root too
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Stray root-level npm install — the real frontend deps live in frontend/.
# The root package.json is the task runner (npm run dev starts both apps). It
# is intentionally tracked and has no dependencies, so a root node_modules or
# lockfile can only come from an accidental `npm install` here — those stay
# ignored so the multi-lockfile confusion never returns. The bundler root is
# pinned in next.config.ts for the same reason.
/node_modules/
/package-lock.json

# OS / editor
.DS_Store
Thumbs.db
*.log

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Local agent tooling (Claude Code skills cache)
.claude/skills/
skills-lock.json
