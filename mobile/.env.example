# Copy to .env and fill in. EXPO_PUBLIC_* variables are inlined into the
# JavaScript bundle at build time — the same rule as NEXT_PUBLIC_* on the web
# — so a build made without them ships pointed at whatever the fallback is.
#
# Nothing here is a secret. The Supabase publishable key is designed to be in
# a client; row-level security is what protects the data, not the key. Never
# put the service-role key in this file.

# The FastAPI backend. eas.json overrides this per build profile.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Your Supabase project's API URL — https://<project-ref>.supabase.co
# NOT the connection pooler host (*.pooler.supabase.com), which is Postgres
# over port 6543 and speaks no HTTP API.
EXPO_PUBLIC_SUPABASE_URL=

# Newer projects call this the publishable key; older ones, the anon key.
# Either name is read.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# From `npx eas project:info`. Needed for push tokens in standalone builds.
EAS_PROJECT_ID=
