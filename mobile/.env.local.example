# Copy to .env.local. EXPO_PUBLIC_ vars are inlined into the bundle at build
# time — the same rule as NEXT_PUBLIC_ on the web — so a build made without
# them ships pointed at localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
