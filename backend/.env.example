# Copy this file to backend/.env and fill in the real values.
# backend/.env is gitignored — never commit real secrets.

# "development" (default) or "production". Only "production" turns on
# validate_startup()'s fail-fast checks in app/core/config.py — it refuses to
# boot at all if DB_URL/SUPABASE_URL/SUPABASE_JWT_SECRET/ANTHROPIC_API_KEY are
# missing, or ALLOWED_ORIGINS is empty/"*". Leave unset for local dev and CI.
ENVIRONMENT=development

# Comma-separated origins the API accepts requests from. Required (non-"*")
# in production — see ENVIRONMENT above. The default below covers local dev.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Root logger level. INFO is right for both dev and production; turn
# individual noisy dependencies down rather than the whole app.
LOG_LEVEL=INFO

# Postgres connection string — Supabase dashboard → Connect → "Session" mode
# (port 5432; right for a persistent backend, not serverless). Looks like:
# postgresql://postgres.[project-ref]:[password]@...supabase.com:5432/postgres
# If your password contains special characters (@, :, /, %), percent-encode
# them (e.g. @ -> %40) or the connection string will silently mis-parse.
DB_URL=

# Anthropic API key — console.anthropic.com -> API Keys. Needed for resume
# scoring and interview question generation/evaluation; without it the app
# falls back to a cruder rule-based scorer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Job sources ──────────────────────────────────────────────────────────
#
# The crawler is the ONLY job source. Every job_listings row comes from an
# employer's own ATS board (Greenhouse, Lever, Ashby, Workable,
# SmartRecruiters, Recruitee — all public JSON, no key, no account, no
# per-call charge) or, for a company on none of those, its own careers page's
# schema.org JobPosting markup (job_market/jsonld_crawler.py). Companies are
# managed in data/companies_seed.csv / the `companies` table
# (job_market/crawler.py); the Job Portal reads that data straight out of
# job_listings via full-text search — no external API call happens when a
# user searches. Nothing below is needed for any of that to work.
#
# Both Apify and JSearch/RapidAPI (an on-demand aggregator this app used to
# fall back to for employers on no known ATS) have been removed. JSearch
# billed nothing per call but was capped at 200 requests/month and required
# a live outbound call on every uncached search; the crawler now covers that
# same breadth for free, on its own schedule, with nothing to query at
# request time.

# Identifies every crawler request (ATS boards and JSON-LD careers pages
# alike) with a real contact in its User-Agent, so an operator who wants to
# block or reach the crawler can. Not required to boot in dev/CI — a missing
# value falls back to a placeholder — but set a real one before running the
# worker against production.
CRAWLER_CONTACT_EMAIL=

# job_market/crawler.py — the companies-table-driven crawl (all six ATS
# adapters plus the JSON-LD fallback). Companies are crawled up to this many
# at once; requests to the same host (several companies can share one, e.g.
# every Greenhouse board hits boards-api.greenhouse.io) are additionally
# throttled to no closer together than the millisecond value below,
# regardless of concurrency.
CRAWLER_CONCURRENCY=10
CRAWLER_PER_DOMAIN_MIN_INTERVAL_MS=250

# How long a closed job_listings row is kept before the crawler hard-deletes it.
JOB_CLOSED_RETENTION_DAYS=90

# Real, enforced ceiling on Claude enrichment spend per crawl run — bounds
# *how many* pending postings a run enriches, computed from a deliberately
# pessimistic per-request cost (job_market/crawler.py's own
# _enrichment_request_cap). A backlog bigger than one run's share isn't
# lost — it's picked up by the next hourly run.
JOB_ENRICH_MAX_COST_PER_RUN_USD=3.00

# Comma-separated allowlist gating the admin crawl API, checked against the
# authenticated user's email — same pattern as ALLOWED_ORIGINS. Empty means
# nobody can reach it, which is the correct default until you set one.
ADMIN_EMAILS=

# Slack-compatible incoming webhook for crawl failure alerts. Optional —
# unset means alerts are logged only.
ALERT_WEBHOOK_URL=

# Set false on a process that should not run the older, in-process
# Greenhouse/Lever/Ashby board sweep (job_market/ingestion.py + scheduler.py)
# — a one-off script, a second replica where one worker already covers it,
# or (the production default, set in docker-compose.prod.yml) the API
# service once the `worker` service covers the same ground and more via
# job_market/crawler.py. Upserts are idempotent, so two sweepers running is
# wasteful rather than wrong.
JOB_SWEEP_ENABLED=true

# Supabase Auth — Project Settings -> API in the dashboard.
SUPABASE_URL=

# Leave blank unless a real test proves the JWKS path doesn't work — this is
# specifically the legacy shared HS256 secret from Settings -> JWT, NOT the
# sb_secret_... Secret API Key below (different credential). Modern Supabase
# projects use signing keys and don't need this at all.
SUPABASE_JWT_SECRET=

# Secret API Key (sb_secret_...) — elevated-privilege key for calling
# Supabase's own APIs directly (admin user management, etc). Not required for
# the app to run day-to-day; only needed for scripts that manage users
# directly. Never expose this client-side.
SUPABASE_SECRET_API_KEY=

# Cross-worker SSE fan-out. Leave blank for a single worker — the event
# manager falls back to in-process fan-out, which is correct for one process
# and silently wrong for more than one (an event published on worker A never
# reaches a client on worker B).
REDIS_URL=

# NOTE on DB_URL: use Supabase's SESSION pooler, port 5432. This file used to
# say the opposite, and that note is why the deployment ran on 6543.
#
# The measurement behind it was real: transaction mode returns the connection
# after each transaction and sustained 120 concurrent here with zero errors,
# where session mode pins one per client and caps at 15 with EMAXCONNSESSION.
# What it missed is that the ceiling is not the only axis. Port 6543 supports
# no prepared statements — which SQLAlchemy emits by default — and holds no
# session state, which is what DDL and Alembic's advisory locks run inside. So
# it fails under migrations and under concurrency, not on the first request,
# which is exactly the shape of bug that survives a load test.
#
# 5432 is correct and slower to saturate. DB_POOL_SIZE and DB_MAX_OVERFLOW are
# set to 5 + 5 to fit under the 15-client cap; if you need more throughput the
# answer is a read replica or PgBouncer you control, not this port.

# ── Google OAuth ─────────────────────────────────────────────────────────
# Reference only — the app never reads these. Supabase performs the OAuth
# exchange, so the real configuration lives in the Supabase dashboard under
# Authentication -> Providers -> Google. Stored here because Google Cloud
# hides the secret permanently once the creation dialog is closed.
#
# In Google Cloud the ONLY authorised redirect URI should be Supabase's
# callback — NOT your own app URL:
#   https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
