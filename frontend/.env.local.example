# Copy this file to frontend/.env.local and fill in the real values.
# frontend/.env.local is gitignored — never commit real secrets.
# VITE_* vars are bundled into client-side JS, so only put values here that are
# safe to expose in the browser. A Firebase web API key is designed for that: it
# identifies the project, it is not a secret. It should still be restricted to
# your own origins (HTTP referrer restriction) in the Google Cloud console.

# Firebase — the web app's config object (Firebase console -> Project settings
# -> Your apps), or `projects.webApps.getConfig` from the Management API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The API. Defaults to http://localhost:8000/api when unset.
VITE_API_BASE_URL=http://localhost:8000/api
