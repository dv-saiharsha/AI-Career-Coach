# Copy this file to frontend/.env.local and fill in the real values.
# frontend/.env.local is gitignored — never commit real secrets.
# NEXT_PUBLIC_* vars are bundled into client-side JS — only put values here
# that are safe to expose in the browser (the publishable key is designed for
# that; it is not the same as the backend's secret key).

# Supabase — Project Settings -> API in the dashboard. Same project as backend/.env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the frontend finds the backend API. Default is correct for local dev
# with both servers running via start.bat.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
