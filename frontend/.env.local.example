# Copy this file to frontend/.env.local and fill in the real values.
# frontend/.env.local is gitignored — never commit real secrets.
# VITE_* vars are bundled into client-side JS — only put values here that are
# safe to expose in the browser (the publishable key is designed for that;
# it is not the same as the backend's secret key).

# Supabase — Project Settings -> API in the dashboard. Same project as backend/.env.
VITE_SUPABASE_URL=https://flgumfsuyipzdgaotphc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where the frontend finds the backend API. Default is correct for local dev
# with both servers running.
VITE_API_BASE_URL=http://localhost:8000/api
